generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Country {
  code      String   @id
  name      String
  dialCode  String
  flag      String   @default("")
  active    Boolean  @default(true)
  sort      Int      @default(0)
  cities    City[]
  stocks    Stock[]
  orders    Order[]
}

model City {
  id           Int     @id @default(autoincrement())
  countryCode  String
  country      Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  name         String
  deliveryFee  Int     @default(0)
  freeAbove    Int?
  active       Boolean @default(true)

  @@index([countryCode])
}

model Category {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  icon      String    @default("")
  image     String    @default("")
  sort      Int       @default(0)
  parentId  Int?
  parent    Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  name     String
  products Product[]
}

model Product {
  id           Int            @id @default(autoincrement())
  slug         String         @unique
  name         String
  sku          String         @default("")
  description  String         @default("")
  specs        String         @default("")
  price        Int
  oldPrice     Int?
  condition    String         @default("Neuf")
  featured     Boolean        @default(false)
  active       Boolean        @default(true)
  views        Int            @default(0)
  categoryId   Int?
  category     Category?      @relation(fields: [categoryId], references: [id])
  brandId      Int?
  brand        Brand?         @relation(fields: [brandId], references: [id])
  images       ProductImage[]
  variants     Variant[]
  stocks       Stock[]
  orderItems   OrderItem[]
  createdAt    DateTime       @default(now())

  @@index([categoryId])
  @@index([brandId])
  @@index([name])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sort      Int     @default(0)

  @@index([productId])
}

model Variant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sku       String  @default("")
  price     Int
  oldPrice  Int?
  stocks    Stock[]
  orderItems OrderItem[]

  @@index([productId])
}

model Stock {
  id          Int     @id @default(autoincrement())
  productId   Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId   Int?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  countryCode String
  country     Country @relation(fields: [countryCode], references: [code], onDelete: Cascade)
  qty         Int     @default(0)

  @@unique([productId, variantId, countryCode])
  @@index([countryCode])
}

model Order {
  id            Int         @id @default(autoincrement())
  number        String      @unique
  countryCode   String
  country       Country     @relation(fields: [countryCode], references: [code])
  city          String
  customerName  String
  phone         String
  whatsapp      String      @default("")
  address       String
  note          String      @default("")
  subtotal      Int
  deliveryFee   Int
  total         Int
  paymentMethod String      @default("COD")
  paymentStatus String      @default("pending")
  paymentRef    String      @default("")
  status        String      @default("new")
  items         OrderItem[]
  createdAt     DateTime    @default(now())

  @@index([phone])
  @@index([status])
}

model OrderItem {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  variantId   Int?
  variant     Variant? @relation(fields: [variantId], references: [id])
  name        String
  variantLabel String  @default("")
  image       String   @default("")
  price       Int
  qty         Int
}

model Setting {
  key   String @id
  value String
}
